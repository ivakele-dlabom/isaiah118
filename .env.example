# =============================================================================
# Configuration for docker-compose.yml
# -----------------------------------------------------------------------------
# 1. Copy this file to ".env" (same folder):   Copy-Item .env.example .env
# 2. Replace every value marked CHANGE ME.
# 3. NEVER commit ".env". It holds secrets (it is listed in .gitignore).
#
# Docker Compose reads ".env" automatically and substitutes these values into
# docker-compose.yml. Do not put quotes around values. If a password contains
# a "$", write it as "$$".
# =============================================================================

# ---- Database ---------------------------------------------------------------
MYSQL_DATABASE=takemybible
MYSQL_USER=takemybible
# CHANGE ME: password the backend uses to connect.
MYSQL_PASSWORD=
# CHANGE ME: password for MySQL's all-powerful "root" account. Different from the one above.
MYSQL_ROOT_PASSWORD=

# ---- Login tokens (JWT) -----------------------------------------------------
# CHANGE ME: long random secret. Generate one in PowerShell:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# Changing it later logs every user out.
JWT_SECRET=
# How long a login lasts, in milliseconds (86400000 = 24 hours).
JWT_EXPIRATION=86400000

# ---- Site -------------------------------------------------------------------
# Public address of the site. For a real server, use your domain,
# e.g. https://bible.example.com
SITE_URL=http://localhost
# Port the site is published on, on the server. 80 is the normal HTTP port.
HTTP_PORT=80

# ---- Optional ---------------------------------------------------------------
# Memory limit for the Java backend. Raise it if the server has plenty of RAM.
BACKEND_MEM_LIMIT=768m
